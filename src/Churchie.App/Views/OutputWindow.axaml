<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Churchie.App.ViewModels"
        xmlns:c="using:Churchie.App.Controls"
        x:Class="Churchie.App.Views.OutputWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Churchie — Projector"
        Icon="/Assets/churchie.ico"
        Background="Black">

  <!-- The projector window: one big slide, nothing else (with a fade between slides). -->
  <c:LiveSlideView Frame="{Binding OutputFrame}" TransitionDuration="{Binding TransitionDuration}" />

</Window>
