<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Churchie.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />

    <!-- A dark "control room" look, like other worship presentation tools. -->
    <Style Selector="Window">
      <Setter Property="Background" Value="#14161F" />
    </Style>

    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#1C1F2B" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10" />
    </Style>

    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#8B93B5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.subtitle">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8B93B5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.screen">
      <Setter Property="Background" Value="Black" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="ClipToBounds" Value="True" />
      <Setter Property="BorderBrush" Value="#E5484D" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>

    <Style Selector="Button.live">
      <Setter Property="Background" Value="#E5484D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="ToggleButton.danger:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5484D" />
    </Style>

    <Style Selector="ListBox.slides">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ListBox.slides ListBoxItem">
      <Setter Property="Padding" Value="5" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <Style Selector="Border.badge">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="5,1" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Application.Styles>

</Application>
